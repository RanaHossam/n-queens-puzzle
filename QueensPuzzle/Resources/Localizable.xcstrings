{
  "sourceLanguage" : "en",
  "strings" : {
    "abandon_game_message" : {
      "comment" : "Alert body explaining that starting a new game will erase the current saved game.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيؤدي بدء لعبة جديدة إلى فقدان تقدمك السابق."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "By starting a new game, all your previous progress will be lost."
          }
        }
      }
    },
    "abandon_game_title" : {
      "comment" : "Alert title shown when the user tries to start a new game while a saved game exists.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هل تريد التخلي عن اللعبة الحالية؟"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abandon last game?"
          }
        }
      }
    },
